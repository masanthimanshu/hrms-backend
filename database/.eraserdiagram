entity-relationship-diagram

user [icon: user, color: blue] {
    id string pk
    name string
    email string
    password hash
    storeId string
    isVerified boolean
    timestamp datetime
}

attendance [icon: calendar, color: green] {
    id string pk
    userId string fk
    latitude float
    longitude float
    distance float
    imageUrl string
    timestamp datetime
}

store [icon: building, color: orange] {
    id string pk
    name string
    address string
    latitude float
    longitude float
    timestamp datetime
}

location [icon: map, color: purple] {
    id string pk
    userId string fk
    latitude float
    longitude float
    distance float
    timestamp datetime
}

user.storeId <> store.id
location.userId <> user.id
user.id <> attendance.userId